# 生产环境模板 — 复制为 .env 后按实际域名/密钥修改
# 目标：更低内存占用、更快响应、可安全对外服务

USE_MILVUS_LITE=true

# --- LLM（必填；Chat / 试卷路由 Agent 共用）---
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=deepseek-v4-flash
# OPENAI_ROUTING_MODEL=   # 可选；空则试卷识别等预处理也用 CHAT_MODEL

# --- 数据平台（空=各业务 SQLite；生产填 PostgreSQL）---
# Docker: docker compose --profile db up -d
# DATABASE_URL=postgresql+psycopg://jnao:jnao@127.0.0.1:5432/jnao
DATABASE_URL=

# --- 模型：小模型显著降内存（bge-m3 约 2GB+，small 约 400MB）---
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BACKEND=sentence_transformers

EMBEDDING_ST_FALLBACK=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_BACKEND=cross_encoder

USE_MODELSCOPE_DOWNLOAD=true
HF_LOCAL_FILES_ONLY=true
TORCH_DEVICE=auto
USE_FP16=true
# 6GB 显存或内存紧张时可改为 2~4
EMBEDDING_BATCH_SIZE=4

# --- 检索性能（Chat SPA 默认走 /chat/stream 快速路径）---
QUERY_REWRITE_ENABLED=false
QUERY_NORMALIZE_ENABLED=true
RETRIEVE_TOP_K=15
RERANK_TOP_K=5
# 流式对话也建议开启重排，否则 hybrid_score 仅为候选内相对分，易误路由
STREAM_SKIP_RERANK=false
STREAM_RETRIEVE_TOP_K=6
STREAM_RERANK_TOP_K=3
STREAM_CONTEXT_MAX_CHARS=700

# --- 检索模式路由（exact / semantic / hybrid + RRF，见 docs/retrieval-mode-routing-plan.md）---
RETRIEVAL_MODE_ROUTER_ENABLED=true
RRF_K=60
EXACT_SKIP_RERANK_ENABLED=true
EXACT_SKIP_RERANK_MIN_SCORE=8.0
STREAM_FAST_DOWNGRADE_HYBRID=true

# task/auto 助手模式走 DeerFlow lead agent；knowledge 始终走 KB 快路径
CHAT_LEAD_AGENT_ENABLED=true

# Presidio 会额外占用内存；生产若已有网关脱敏可关闭
USE_PRESIDIO=false

# --- Redis 检索缓存（推荐：重复检索命中缓存；无 REDIS_URL 时用进程内缓存）---
# Docker: docker compose --profile cache up -d
# Linux 服务器：apt install redis-server 或云 Redis
# Windows 开发机：可不配 REDIS_URL，仅 REDIS_SEARCH_CACHE_ENABLED=true 即可用内存缓存
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SEARCH_CACHE_ENABLED=true
REDIS_SEARCH_CACHE_TTL_SECONDS=600

# 流式对话为主且跳过重排时，可不预热重排模型（省 ~500MB 内存，首次 /chat 会慢）
WARMUP_RERANKER_ON_STARTUP=false

# --- API 安全（本地开发可全部留空）---
# RAG_API_SECRET=
# RAG_ADMIN_API_SECRET=
# CORS_ALLOW_ORIGINS=
# DISABLE_OPENAPI_DOCS=false
# TRUSTED_HOSTS=
# ENABLE_HSTS=false

# 本地 JSONL 全链路 trace（默认开启；Admin 反馈「查看链路」）
LOCAL_TRACE_ENABLED=true

# Langfuse v4 全链路观测（可选；与 DeerFlow 8011 共用变量，见 docs/langfuse-tracing.md）
# 本地 SDK：pip install -e D:/LangFuse_python/langfuse-python
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Chat 对话工具：Tavily 联网搜索 ---
# 在 https://tavily.com 注册获取 API Key；管理后台「工具 → 对话工具」中启用 web_search
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=12

# --- DeerFlow harness (Sprint G / DF-0) ---
# Local checkout used by tests and optional .venv-deerflow
DEER_FLOW_HARNESS_PATH=D:\bytedance flow\deer-flow\backend\packages\harness
DEER_FLOW_PROJECT_ROOT=
DEER_FLOW_CONFIG_PATH=
DEER_FLOW_EXTENSIONS_CONFIG_PATH=
